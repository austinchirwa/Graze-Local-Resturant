{
  // Disable VS Code's built-in CSS validator — it doesn't understand
  // Tailwind's custom at-rules (@tailwind, @apply, @layer, @config).
  "css.validate": false,
  "less.validate": false,
  "scss.validate": false,

  // Use the Tailwind CSS IntelliSense extension for CSS language features.
  // This gives you autocomplete, hover docs, and proper linting for Tailwind.
  "editor.quickSuggestions": {
    "strings": "on"
  },

  // Tell the Tailwind extension which files to activate on
  "tailwindCSS.includeLanguages": {
    "typescriptreact": "html",
    "javascriptreact": "html"
  },

  // Experimental: support @apply in CSS files
  "tailwindCSS.experimental.classRegex": [],

  // File associations
  "files.associations": {
    "*.css": "tailwindcss"
  }
}
