// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Menu {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  price       Float
  category    String
}
